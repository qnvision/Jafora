<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
	<Dialog showHeader="false" id="userMessageDialog" class="userMsgDialog">
		<VBox class="userMsg">
			<HBox class="ERRORText">
				<core:Icon src="sap-icon://alert" size="31px" color="#BE0000"/>
				<Text text=" " width="10px"/>
				<Text text="{i18n>ERROR}"/>
			</HBox>
			<HBox width="100%" class="toolbarHbox">
				<OverflowToolbar class="errorToolbar"></OverflowToolbar>
			</HBox>
			<HBox class="wrongMaterialBox">
				<Text text="{appData>/MaterialMessage}"/>
			</HBox>
			<HBox class="agreeButtonBox">
				<Button text="{i18n>agreement}" type="Transparent" class="agreeButton" press="closeUserMsgDialog"></Button>
			</HBox>
		</VBox>
	</Dialog>
</core:FragmentDefinition>